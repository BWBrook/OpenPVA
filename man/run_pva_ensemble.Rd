% Generated by scripts/build_rd.R from scripts/rd_topics.R; edit those files.
\name{run_pva_ensemble}
\alias{run_pva_ensemble}
\title{Run a designed ensemble of scenarios}
\usage{
run_pva_ensemble(
  design,
  build,
  n_runs,
  summarise = NULL,
  seed = NULL,
  seed_by = NULL,
  workers = 1L,
  backend = c("auto", "fork", "psock"),
  cluster = NULL,
  validation = c("strict", "fast"),
  cache_dir = NULL,
  cache_key = NULL
)
}
\arguments{
\item{design}{Data frame with one row per ensemble member, for example the cross of structural variants, parameter draws and management options.}
\item{build}{Function of one design row (a named list) returning a list with \code{init_fun}, \code{processes} and \code{n_steps}, and optionally \code{initial_census}, \code{dt} and \code{keep}.}
\item{n_runs}{Number of inner Monte Carlo replicates per member.}
\item{summarise}{Function of \code{(result, row)} returning a data frame of summaries for one member. The default is \code{\link{summarise_pva}()}.}
\item{seed}{Root seed from which member seeds are derived.}
\item{seed_by}{Optional design columns that define blocks sharing one seed (common random numbers), for example the structural and parametric columns when management options should be compared on paired streams.}
\item{workers}{Number of local worker processes.}
\item{backend}{\code{"fork"}, \code{"psock"}, or \code{"auto"} (fork on Unix, PSOCK on Windows).}
\item{cluster}{Optional cluster from \code{parallel::makePSOCKcluster()}. Use this to reuse workers or to initialise dependencies looked up dynamically.}
\item{validation}{\code{"strict"} checks every process transition (declared writes, types, engine-owned fields and cohort accounting). \code{"fast"} skips those checks and gives bit-identical output for a valid model.}
\item{cache_dir}{Optional directory for resumable member summaries.}
\item{cache_key}{Optional revision string for model inputs read from external files or resolved dynamically.}
}
\description{
Separates the outer design (structure, parameters, management) from the inner Monte Carlo replicates. Each member is built, run and reduced to its summary inside a worker, so memory use does not grow with the size of the design.
}
\details{
The builder and summary draw on a reproducible member substream. Cache entries record callback code and statically referenced inputs, package and R versions, the row, member seed, replicate count, validation mode and cache key. Member seeds are a deterministic function of \code{seed} and the design order, so the ensemble is reproducible and independent of the number of workers and of the backend.
}
\value{
A data frame: the design rows, \code{member}, \code{member_seed} and the summary columns. Provenance is attached as an attribute.
}
\examples{
design <- expand.grid(survival = c(0.7, 0.9), harvest = c(0, 2))
build <- function(row) {
  list(
    n_steps = 10,
    init_fun = function() pva_population(sex = rep(c("F", "M"), 10), age = 1),
    processes = list(
      survival_process(row$survival),
      removal_process(count = row$harvest),
      census_process()
    )
  )
}
run_pva_ensemble(design, build, n_runs = 40, seed = 7,
  summarise = function(result, row) summarise_pva(result, threshold = 5)
)[, c("survival", "harvest", "p_ever_below", "p_ever_below_mcse")]
}
