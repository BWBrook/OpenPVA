% Generated by scripts/build_rd.R from scripts/rd_topics.R; edit those files.
\name{environment_processes}
\alias{environment_processes}
\alias{environment_process}
\alias{catastrophe_process}
\alias{beta_shapes}
\alias{shift_logit}
\title{Environmental variation and catastrophes}
\usage{
environment_process(
  variables,
  name = "environment",
  requires = character(),
  params = list()
)

catastrophe_process(
  probability,
  mortality = NULL,
  eligible = NULL,
  name = "catastrophe",
  global = name,
  requires = character(),
  params = list()
)

beta_shapes(mean, sd)

shift_logit(probability, deviation)
}
\arguments{
\item{variables}{Named list of functions of \code{(state, context, params)}. Each value is written to the global of the same name, in order, so later functions can read earlier ones.}
\item{name}{Process name used in events, accounting and error messages.}
\item{requires}{Additional state paths (\code{population.<field>} or \code{globals.<name>}) read by the supplied functions; checked before a run starts.}
\item{params}{Named list of modeller parameters, passed unchanged to every supplied function as \code{params}.}
\item{probability}{For \code{catastrophe_process()}: the per-interval probability of a catastrophe, as one number or a function of \code{(state, context, params)}. For \code{shift_logit()}: probabilities to shift.}
\item{mortality}{Optional direct mortality applied when a catastrophe occurs: one probability, or a function of \code{(pop, state, context, params)}.}
\item{eligible}{Optional function of \code{(pop, state, context, params)} returning one logical value per living individual. \code{NULL} means every living individual.}
\item{global}{Name of the logical global that records whether the catastrophe occurred this interval.}
\item{mean}{Mean of the beta distribution, in (0, 1).}
\item{sd}{Standard deviation of the beta distribution.}
\item{deviation}{Deviation added on the logit scale. Structural probabilities zero and one remain fixed even under infinite shifts.}
}
\description{
\code{environment_process()} draws the interval's shared environmental conditions into globals, where rate functions read them. \code{catastrophe_process()} draws a Bernoulli catastrophe flag and can apply direct mortality. \code{beta_shapes()} converts a mean and standard deviation to beta shape parameters, and \code{shift_logit()} perturbs probabilities on the logit scale.
}
\value{
The process constructors return a \code{pva_process}. \code{beta_shapes()} returns a list with \code{shape1} and \code{shape2}; \code{shift_logit()} returns probabilities.
}
\examples{
weather <- environment_process(
  variables = list(survival_deviate = function(state, context, params) rnorm(1, 0, 0.3))
)
cyclone <- catastrophe_process(probability = 0.05, mortality = 0.4, name = "cyclone")
survival <- survival_process(
  probability = function(pop, state, context, params) {
    shift_logit(0.85, state$globals$survival_deviate)
  },
  requires = "globals.survival_deviate"
)
state <- pva_state(
  pva_population(sex = rep(c("F", "M"), 25), age = 2),
  globals = list(survival_deviate = 0, cyclone = FALSE)
)
set.seed(3)
execute_processes(state, list(weather, cyclone, survival, census_process()))$census
}
