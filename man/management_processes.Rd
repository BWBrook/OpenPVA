\name{management_processes}
\alias{management_processes}
\alias{removal_process}
\alias{ceiling_process}
\alias{introduction_process}
\alias{pairing_process}
\title{Removal, ceiling, introduction and pairing processes}
\usage{
removal_process(
  count = NULL,
  probability = NULL,
  select = NULL,
  eligible = NULL,
  order = c("random", "id"),
  cause = "removal",
  name = "removal",
  requires = character(),
  params = list()
)

ceiling_process(
  capacity,
  eligible = NULL,
  cause = "ceiling",
  name = "ceiling",
  requires = character(),
  params = list()
)

introduction_process(
  count,
  fields,
  creates = c("sex", "age"),
  source = "introduction",
  name = "introduction",
  requires = character(),
  params = list()
)

pairing_process(
  eligible,
  capacity = Inf,
  priority = c("id", "lottery"),
  field = "mate_id",
  name = "pairing",
  requires = character(),
  params = list()
)
}
\arguments{
\item{count}{Number of individuals to remove or introduce in an interval: one number, or a function of \code{(state, context, params)}. A removal takes at most the eligible number and reports any shortfall.}
\item{probability}{Per-capita removal probability: one number, or a function of \code{(pop, state, context, params)}.}
\item{select}{Function of \code{(pop, state, context, params)} returning the rows (or a logical vector) of the individuals to remove.}
\item{eligible}{Function of \code{(pop, state, context, params)} returning one logical value per living individual. Optional (\code{NULL} means everyone) except for \code{pairing_process()}.}
\item{order}{How a \code{count} removal chooses individuals: at random, or lowest identifiers first.}
\item{cause}{Label stored with the accounting event, for example \code{"natural"} or \code{"harvest"}.}
\item{name}{Process name used in events, accounting and error messages.}
\item{requires}{Additional state paths (\code{population.<field>} or \code{globals.<name>}) read by the supplied functions; checked before a run starts.}
\item{params}{Named list of modeller parameters, passed unchanged to every supplied function as \code{params}.}
\item{capacity}{Capacity: one number, or a function of \code{(state, context, params)}. For \code{ceiling_process()} the maximum number of eligible individuals; for \code{pairing_process()} the maximum number of pairs (territories).}
\item{fields}{Function of \code{(n, state, context, params)} returning a named list with \code{sex}, \code{age} and every non-core field (and optionally \code{mother_id} and \code{father_id}) of the \code{n} introduced individuals.}
\item{creates}{Fields that \code{fields} initialises.}
\item{source}{Label stored with the introduction event.}
\item{priority}{Which eligible individuals obtain a pair when capacity is limiting: lowest identifiers first (\code{"id"}) or a random draw (\code{"lottery"}).}
\item{field}{Integer population field that receives each paired individual's mate identifier.}
}
\description{
\code{removal_process()} takes individuals out of the population as accounted removals (harvest, culling, capture). \code{ceiling_process()} imposes a hard abundance ceiling by random deaths. \code{introduction_process()} adds individuals (supplementation, release, immigration). \code{pairing_process()} forms monogamous pairs each interval up to a capacity, leaving surplus eligible individuals as unpaired floaters; with unlimited capacity it is a pair (mate) limitation, with finite capacity a territory limit.
}
\value{
A \code{pva_process}.
}
\examples{
state <- pva_state(pva_population(
  sex = rep(c("F", "M"), each = 4), age = 2, mate_id = NA_integer_
))
territories <- pairing_process(
  eligible = function(pop, state, context, params) pop$age >= 1,
  capacity = 2
)
cull <- removal_process(count = 1, cause = "cull")
release <- introduction_process(
  count = 2,
  fields = function(n, state, context, params) {
    list(sex = c("F", "M"), age = 1L, mate_id = NA_integer_)
  },
  creates = c("sex", "age", "mate_id")
)
set.seed(1)
out <- execute_processes(state, list(territories, cull, release, census_process()))
out$events[, c("process_name", "event_type", "value")]
}
