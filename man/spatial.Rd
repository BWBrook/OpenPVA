\name{spatial}
\alias{spatial}
\alias{patch_counts}
\alias{dispersal_process}
\alias{markov_dispersal_process}
\title{Movement among discrete patches}
\usage{
patch_counts(pop, patches, field = "patch_id")

dispersal_process(
  destination,
  patches,
  eligible = NULL,
  field = "patch_id",
  name = "dispersal",
  requires = character(),
  params = list()
)

markov_dispersal_process(
  transition,
  eligible = NULL,
  field = "patch_id",
  name = "dispersal",
  requires = character()
)
}
\arguments{
\item{pop}{A columnar population.}
\item{patches}{Vector of the declared patch identifiers.}
\item{field}{Population field holding each individual's patch.}
\item{destination}{Function of \code{(rows, pop, state, context, params)} returning one declared patch per eligible individual.}
\item{eligible}{Optional function of \code{(pop, state, context, params)} returning one logical value per living individual. \code{NULL} means every living individual.}
\item{name}{Process name used in events, accounting and error messages.}
\item{requires}{Additional state paths (\code{population.<field>} or \code{globals.<name>}) read by the supplied functions; checked before a run starts.}
\item{params}{Named list of modeller parameters, passed unchanged to every supplied function as \code{params}.}
\item{transition}{Square row-stochastic matrix whose row and column names are the patch identifiers.}
}
\description{
\code{dispersal_process()} moves eligible individuals to modeller-chosen patches; \code{markov_dispersal_process()} draws each destination from a transition matrix. The \code{dispersal} event counts movers. Each \code{patch_transition} row reports one realised origin, destination and count, including eligible individuals who stayed. \code{patch_counts()} tabulates abundance by patch for patch-specific density feedback.
}
\value{
The constructors return a \code{pva_process}; \code{patch_counts()} returns a named integer vector.
}
\examples{
transition <- matrix(c(0.9, 0.1, 0.2, 0.8), 2, byrow = TRUE,
                     dimnames = list(c("north", "south"), c("north", "south")))
state <- pva_state(pva_population(sex = rep(c("F", "M"), 10), age = 2, patch_id = "north"))
set.seed(4)
moved <- execute_processes(state, list(markov_dispersal_process(transition)))
patch_counts(moved$state$population, c("north", "south"))
}
