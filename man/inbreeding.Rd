% Generated by scripts/build_rd.R from scripts/rd_topics.R; edit those files.
\name{inbreeding}
\alias{inbreeding}
\alias{summarise_pedigree}
\alias{kinship_matrix}
\alias{inbreeding_multiplier}
\alias{inbreeding_proxy_process}
\alias{sex_ratio_effective_size}
\title{Pedigree summaries and inbreeding depression}
\usage{
summarise_pedigree(state)

kinship_matrix(state, ids = state$population$id)

inbreeding_multiplier(inbreeding, lethal_equivalents)

inbreeding_proxy_process(
  effective_size,
  generation_time,
  migration = NULL,
  name = "inbreeding_proxy",
  global = "inbreeding_proxy",
  requires = character(),
  params = list()
)

sex_ratio_effective_size(n_females, n_males)
}
\arguments{
\item{state}{A \code{pva_state}.}
\item{ids}{Distinct living IDs, in desired matrix order. Defaults to every living individual.}
\item{inbreeding}{Inbreeding coefficients in [0, 1].}
\item{lethal_equivalents}{Slope \code{B} of the log-linear cost \code{exp(-B * F)}.}
\item{effective_size}{Function of \code{(pop, state, context, params)} returning the interval's effective population size.}
\item{generation_time}{Generation time in model intervals. Required for the effective-size approximation.}
\item{migration}{Optional function of \code{(pop, state, context, params)} returning the fraction of the gene pool replaced by unrelated immigrants this interval.}
\item{name}{Process name used in events, accounting and error messages.}
\item{global}{Name of the numeric global holding the aggregate inbreeding coefficient.}
\item{requires}{Additional state paths (\code{population.<field>} or \code{globals.<name>}) read by the supplied functions; checked before a run starts.}
\item{params}{Named list of modeller parameters, passed unchanged to every supplied function as \code{params}.}
\item{n_females}{Number of breeding females.}
\item{n_males}{Number of breeding males.}
}
\description{
\code{summarise_pedigree()} reports exact mean and maximum individual inbreeding, mean living kinship (including self-kinship) and gene diversity. \code{kinship_matrix(state, ids)} returns coancestry for the requested living individuals. The retained ancestry grows with the recorded pedigree. Starting animals with nonzero mutual kinship retain a covariance block. A full returned matrix requires quadratic space. \code{inbreeding_multiplier()} scales a particular fitness component by \code{exp(-B * F)} using lethal equivalents for that component and period.
}
\details{
The scalar proxy converts per-generation drift to per-interval drift \eqn{d = 1 - (1 - 1/(2N_e))^{1/G}}, with generation time \eqn{G}. The per-generation drift is capped at one, and zero effective size leaves drift at zero. The update is \eqn{(d + (1-d)F)(1-m)^2}, where \eqn{m} is the interval's immigrant gene fraction. Initialise the target global with a coefficient in [0, 1]. An interval with introductions and no migration function raises an error in strict mode and a warning in fast mode. This scalar approximation misses F1 heterosis under supplementation. Use \code{pedigree = TRUE} to distinguish the kinships of individual matings. \code{sex_ratio_effective_size()} gives \eqn{4N_fN_m/(N_f+N_m)}.
}
\value{
\code{summarise_pedigree()} returns a one-row data frame; \code{kinship_matrix()} a numeric matrix; \code{inbreeding_multiplier()} and \code{sex_ratio_effective_size()} numeric vectors; \code{inbreeding_proxy_process()} a \code{pva_process}.
}
\examples{
inbreeding_multiplier(c(0, 0.125, 0.25), lethal_equivalents = 3)
scenario <- scenario_spec(
  name = "one_pair", n_runs = 1, n_steps = 4, seed = 2,
  init_fun = function() {
    pva_state(pva_population(sex = c("F", "M"), age = 2), pedigree = TRUE)
  },
  processes = list(
    age_process(),
    reproduction_process(
      breeding_probability = function(pop, state, context, params) as.numeric(pop$age >= 2),
      litter_size = litter_categorical(2, 1),
      offspring_sex = offspring_sex_bernoulli(0.5),
      mate = mate_random(function(pop, state, context, params) pop$age >= 2),
      require_mate = TRUE
    ),
    census_process()
  )
)
summarise_pedigree(run_scenario(scenario, keep = "state")$states[[1]])
}
